    "weak": [
      {"file": "Dockerfile"},
      {"file": "Containerfile"},
      {"file": "compose.yaml"},
      {"file": "docker-compose.yml"},
      {"file": ".gitlab-ci.yml"},
      {"glob": ".github/workflows/*.yml"},
      {"dir": "k8s"},
      {"dir": "manifests"}
    ]
  },
  "skills": [
